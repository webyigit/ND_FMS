# Google 드라이브 증빙 저장 (교회 Google 계정의 OAuth 클라이언트 + 갱신 토큰)
# 값은 배포 환경 설정에만 넣고 저장소에 커밋하지 않는다.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# 증빙 최상위 폴더 ID (그 아래 지출증빙/연/월 폴더가 자동 생성됨)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Supabase (무료 플랜): 프로젝트 설정 > API 의 Project URL 과 publishable(anon) 키
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 카카오 로그인 버튼 표시 (Supabase Auth 에서 Kakao 제공자를 켠 뒤 on)
NEXT_PUBLIC_AUTH_KAKAO=
