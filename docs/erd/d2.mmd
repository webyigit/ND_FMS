  bank_account { int id PK
    text bank
    bytea account_no_enc
    text kind "일반/대출/외화/적금" }
  bank_import { bigint id PK
    text file_name
    date period_from
    date period_to }
  bank_tx { bigint id PK
    timestamptz tx_at
    bigint withdraw
    bigint deposit
    bigint balance
    text description "거래기록사항"
    int suggested_offering_type_id
    bool linked }
  department { int id PK
    text name
    bigint head_member_id FK }
  expense_item { int id PK
    int department_id FK
    int fund_id FK
    text name }
  expense { bigint id PK
    int week_id FK
    int expense_item_id FK
    int budget_source_item_id FK
    text content
    bigint amount
    bigint fee
    uuid split_group }
  payee { bigint id PK
    bigint member_id FK
    text bank
    bytea account_no_enc }
  receipt_file { bigint id PK
    text storage_path
    jsonb extracted }
  fixed_expense { int id PK
    int week_of_month
    text content
    bigint amount }
  reconciliation { int week_id PK
    bigint bank_balance "A"
    bigint pending_deposit "B"
    bigint mission_unremitted "D"
    bigint base_surplus "H" }
  fund_transfer { bigint id PK
    int from_fund FK
    int to_fund FK
    bigint amount }
  fund { int id PK
    text name }
  week { int id PK
    date sunday }
  member { bigint id PK
    text name }
